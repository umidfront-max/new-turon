# Complaints API
# Ishlab chiqishda so'rovlar Vite proxy orqali ketadi (vite.config.js) — shunda
# CORS qatnashmaydi va ngrok ogohlantirish sahifasi chetlab o'tiladi.
VITE_API_URL=/api/v1
VITE_API_PROXY=https://pinchable-semitruthfully-delma.ngrok-free.dev

# To'g'ridan-to'g'ri ulanmoqchi bo'lsangiz to'liq manzil yozing:
# VITE_API_URL=https://pinchable-semitruthfully-delma.ngrok-free.dev/api/v1
# VITE_API_URL=http://192.168.14.186:30801/api/v1

# Auth Gateway — kirish oqimi to'liq shu yerdan: kalit -> yuz -> JWT
# http://192.168.14.186/auth-gateway/docs
# Tunnel orqali sinaganda shu qatorni almashtiring, boshqa hech narsa kerak emas.
VITE_GATEWAY_URL=http://192.168.14.186/auth-gateway

# ERI kirish xizmati — hozir kirish oqimida ishlatilmaydi (darvoza uni o'zi
# chaqiradi), services/eriLogin.js dagi loginPfxB64() uchun qoldirilgan.
# http://192.168.14.186/eri-login/docs
VITE_ERI_URL=http://192.168.14.186/eri-login

# Fayllar (sanksiya qarori PDF) MinIO'da turadi
VITE_MEDIA_URL=http://192.168.14.127:9000

# Yuz tekshiruvi WebSocket'i.
#
# Odatda kerak emas: darvoza `face_ws_url` ni o'zi qaytaradi.
#
# Diqqat -- chipta va yuz xizmati BIR o'rnatmadan bo'lishi shart. Chiptani
# `/auth-gateway/` beradi va u faqat LAN'da; tunneldagi wss://.../ws/face esa
# boshqa kalit bilan tekshiradi va "Signature verification failed" qaytaradi.
# Tunneldagi /eri-login/login-pfx javobida chipta umuman yo'q.
#
# Ya'ni tunnelga o'tkazish uchun avval /auth-gateway/ o'sha tunnelda ochilishi
# kerak. Ochilgach quyidagi qatorni yoqing:
# VITE_FACE_WS=wss://pinchable-semitruthfully-delma.ngrok-free.dev/ws/face
#
# Qiymat faqat xost bo'lsa (wss://host) yo'l serverdagicha qoladi; to'liq
# manzil ham, xost ham bo'lmasa ulanish sahifaning o'z manziliga, ya'ni Vite
# proxy orqali ketadi (vite.config.js dagi /face-recog).
